{
  "name": "biztel-vision-intel-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev --workspace @biztel/api",
    "dev:web": "npm run dev --workspace @biztel/web",
    "build": "npm run build --workspace @biztel/contracts && npm run build --workspace @biztel/api && npm run build --workspace @biztel/web",
    "start": "npm run start --workspace @biztel/api"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
